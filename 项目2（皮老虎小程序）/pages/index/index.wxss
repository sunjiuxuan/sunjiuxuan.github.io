.container {
  padding: 24rpx;
  padding-bottom: 60rpx;
}

/* 顶部轮播图大图区 */
.banner-wrapper {
  margin-bottom: 24rpx;
}

.banner-box {
  height: 340rpx;
  border-radius: 20rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 10rpx 30rpx -5rpx rgba(184, 40, 27, 0.28);
}

.banner-real-img {
  width: 100%;
  height: 100%;
}

.banner-art-content {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #B8281B 0%, #8D180E 100%);
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  border: 2rpx solid #D4A86A;
  border-radius: 20rpx;
  padding: 20rpx;
}

.banner-top-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.seal-mark {
  background: #FFFFFF;
  color: #B8281B;
  font-size: 20rpx;
  font-weight: bold;
  padding: 2rpx 10rpx;
  border-radius: 4rpx;
  letter-spacing: 2rpx;
}

.banner-subtitle {
  font-size: 22rpx;
  color: #F7D8B5;
  letter-spacing: 2rpx;
}

.banner-main-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.2);
}

.banner-caption {
  font-size: 22rpx;
  color: #FBEAD6;
  opacity: 0.9;
  letter-spacing: 2rpx;
}

.banner-indicator-bar {
  position: absolute;
  bottom: 16rpx;
  display: flex;
  gap: 10rpx;
}

.bar {
  width: 10rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(255, 255, 255, 0.35);
  transition: all 0.3s ease;
}

.bar.active {
  width: 32rpx;
  background: #ECC38B;
}

/* 非遗介绍卡片 */
.heritage-intro {
  padding: 30rpx 28rpx;
  margin-bottom: 28rpx;
}

.intro-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
}

.line-ornament {
  width: 36rpx;
  height: 2rpx;
  background: #C59A58;
}

.header-seal {
  background: #B8281B;
  color: #FFFFFF;
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 16rpx;
  font-size: 18rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  border: 1rpx solid #E5BA80;
}

.seal-char {
  display: inline-block;
  line-height: 1;
}

.intro-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1917;
  letter-spacing: 2rpx;
  margin-right: 16rpx;
}

.intro-paragraph {
  font-size: 26rpx;
  line-height: 1.85;
  color: #5C524B;
  text-align: justify;
  display: block;
}

.craft-badges {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F2ECE1;
}

.craft-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #8C6F48;
}

.craft-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #B8281B;
  margin-right: 8rpx;
}

/* 商品区 */
.section-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.main-heading {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1917;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

.sub-heading {
  font-size: 22rpx;
  color: #8F857D;
}

.filter-pill {
  font-size: 22rpx;
  color: #8F857D;
  display: flex;
  align-items: center;
}

.arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
}

.goods-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.goods-card {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.2s ease;
}

.goods-img-box {
  height: 250rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.goods-img {
  width: 100%;
  height: 100%;
}

.goods-placeholder-art {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.art-seal-mini {
  font-size: 26rpx;
  font-weight: bold;
  letter-spacing: 4rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.4);
  padding-bottom: 4rpx;
  margin-bottom: 6rpx;
}

.art-sub {
  font-size: 20rpx;
  opacity: 0.85;
  letter-spacing: 1rpx;
}

.tag-floating {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(29, 25, 23, 0.7);
  backdrop-filter: blur(4px);
  color: #F8E5CE;
  font-size: 18rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(248, 229, 206, 0.3);
}

.goods-detail {
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.goods-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1917;
  margin-bottom: 4rpx;
}

.goods-subtitle {
  font-size: 22rpx;
  color: #8F857D;
  margin-bottom: 18rpx;
}

.goods-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price-container {
  color: #B8281B;
  font-weight: 700;
  display: flex;
  align-items: baseline;
}

.currency {
  font-size: 24rpx;
  margin-right: 2rpx;
}

.amount {
  font-size: 36rpx;
}

.cents {
  font-size: 22rpx;
}

.btn-buy {
  background: #B8281B;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(184, 40, 27, 0.2);
}
