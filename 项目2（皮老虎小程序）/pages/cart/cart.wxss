.cart-page {
  padding: 24rpx;
  padding-bottom: 160rpx;
}

/* 顶部服务通知 */
.service-notice {
  background: #FDF7EE;
  border: 1rpx solid #F3E6D0;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.notice-left {
  display: flex;
  align-items: center;
}

.notice-badge {
  background: #C59A58;
  color: #FFFFFF;
  font-size: 18rpx;
  font-weight: bold;
  padding: 2rpx 8rpx;
  border-radius: 4rpx;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

.notice-text {
  font-size: 22rpx;
  color: #7A5B32;
}

.notice-more {
  font-size: 20rpx;
  color: #A88656;
}

/* 列表区 */
.cart-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.cart-card {
  padding: 24rpx 20rpx;
  display: flex;
  align-items: center;
}

/* 矢量定制复选框 */
.custom-checkbox {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  border: 2rpx solid #C8BFB5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  transition: all 0.2s;
}

.custom-checkbox.checked {
  background: #B8281B;
  border-color: #B8281B;
}

.check-tick {
  width: 14rpx;
  height: 8rpx;
  border-left: 3rpx solid #FFFFFF;
  border-bottom: 3rpx solid #FFFFFF;
  transform: rotate(-45deg) translate(1rpx, -2rpx);
}

.goods-thumb-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.06);
}

.thumb-img {
  width: 100%;
  height: 100%;
}

.thumb-art {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #FFFFFF;
}

.thumb-char {
  font-size: 38rpx;
  font-weight: bold;
  font-family: "Songti SC", serif;
  letter-spacing: 2rpx;
}

.thumb-sub {
  font-size: 18rpx;
  opacity: 0.85;
  margin-top: 2rpx;
}

.goods-info-col {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.goods-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1D1917;
  line-height: 1.3;
}

.delete-link {
  font-size: 22rpx;
  color: #A89D93;
}

.spec-capsule-tag {
  background: #F7F3EB;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  display: inline-flex;
  align-items: center;
  margin-bottom: 16rpx;
  align-self: flex-start;
  border: 1rpx solid #ECE3D4;
}

.spec-prefix {
  font-size: 20rpx;
  color: #8F857D;
}

.spec-content {
  font-size: 20rpx;
  color: #B8281B;
  font-weight: 600;
}

.card-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-box {
  color: #B8281B;
  font-weight: 700;
  display: flex;
  align-items: baseline;
}

.sym { font-size: 22rpx; margin-right: 2rpx; }
.val { font-size: 34rpx; }
.dot { font-size: 22rpx; }

/* 极简高质感步进器 */
.luxury-stepper {
  display: flex;
  align-items: center;
  border: 1rpx solid #DDD4C7;
  border-radius: 8rpx;
  overflow: hidden;
  background: #FAF8F5;
}

.step-ctrl {
  width: 44rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #5C524B;
  font-weight: 600;
}

.step-value {
  width: 52rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: #FFFFFF;
  border-left: 1rpx solid #EBE4D8;
  border-right: 1rpx solid #EBE4D8;
  color: #1D1917;
  font-weight: 500;
}

/* 底部结算悬浮栏 */
.cart-footer-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
  border-top: 1rpx solid #EBE4D8;
  z-index: 100;
}

.footer-select-all {
  display: flex;
  align-items: center;
}

.select-all-label {
  font-size: 26rpx;
  color: #5C524B;
}

.footer-checkout-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.total-summary {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.sum-line {
  display: flex;
  align-items: baseline;
}

.sum-label {
  font-size: 24rpx;
  color: #5C524B;
}

.sum-sym {
  font-size: 22rpx;
  color: #B8281B;
  font-weight: bold;
}

.sum-amount {
  font-size: 40rpx;
  font-weight: 800;
  color: #B8281B;
  line-height: 1;
}

.sum-dot {
  font-size: 22rpx;
  color: #B8281B;
  font-weight: bold;
}

.sum-benefit {
  font-size: 18rpx;
  color: #9C7235;
  margin-top: 2rpx;
}

.btn-checkout {
  padding: 20rpx 42rpx;
  font-size: 28rpx;
  letter-spacing: 1rpx;
}
