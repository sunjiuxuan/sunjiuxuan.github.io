.member-page {
  background-color: #720b18; /* 全局深红色 */
  min-height: 100vh;
}

.member-header {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.header-title {
  color: #fff;
  font-size: 16px;
  font-weight: bold;
}

.notice-bar {
  background-color: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 11px;
  padding: 6px 15px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  margin: 10px 15px 0;
}

.member-card {
  margin: 0 15px 20px;
  background: linear-gradient(135deg, #f7cece 0%, #e8a2a2 100%);
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
  padding: 20px 20px;
  position: relative;
  box-shadow: 0 5px 15px rgba(0,0,0,0.1);
  color: #720b18;
}

.card-level-tag {
  background: #a92731;
  color: #fff;
  font-size: 10px;
  padding: 3px 10px;
  border-radius: 10px;
  display: inline-block;
  margin-bottom: 10px;
}

.card-name {
  font-size: 20px;
  font-weight: bold;
  margin-bottom: 25px;
}

.card-values {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.value-left {
  flex: 1;
}

.num {
  font-size: 22px;
  font-weight: bold;
  margin-bottom: 5px;
  display: block;
}

.progress-bar {
  height: 2px;
  background: rgba(114, 11, 24, 0.2);
  width: 70%;
  position: relative;
  margin-bottom: 8px;
}

.progress-inner {
  width: 0%;
  height: 100%;
  background: #720b18;
}

.heart-icon {
  position: absolute;
  left: 0;
  top: -6px;
  font-size: 12px;
}

.upgrade-tips {
  font-size: 10px;
  opacity: 0.8;
}

.value-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.num-big {
  font-size: 28px;
  font-weight: bold;
}

.val-label {
  font-size: 11px;
}

.rights-title {
  text-align: center;
  color: #fff;
  font-size: 14px;
  font-weight: bold;
  margin: 10px 0 20px;
}

.rights-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 10px;
}

.right-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20px;
  color: #fff;
  font-size: 11px;
}

.r-icon {
  width: 44px;
  height: 44px;
  background: rgba(255,255,255,0.2);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22px;
  margin-bottom: 8px;
}

.dark-item {
  opacity: 0.4; /* 未解锁状态模拟 */
}

.activity-scroll {
  width: 100%;
  margin-top: 10px;
}

.activity-list {
  display: flex;
  padding: 0 15px;
  width: max-content;
}

.act-card {
  width: 140px;
  height: 100px;
  border-radius: 8px;
  margin-right: 12px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 10px;
  position: relative;
  overflow: hidden;
}

.act-bg-1 { background: linear-gradient(135deg, #d37979 0%, #aa3e3e 100%); }
.act-bg-2 { background: linear-gradient(135deg, #b01a1a 0%, #720b18 100%); }
.act-bg-3 { background: linear-gradient(135deg, #440b0b 0%, #200505 100%); }

.act-title {
  color: #fff;
  font-size: 12px;
  z-index: 2;
  font-weight: 500;
}

.act-img {
  position: absolute;
  top: 15px;
  font-size: 45px;
  z-index: 1;
}

.bottom-spacer {
  height: 60px;
}
